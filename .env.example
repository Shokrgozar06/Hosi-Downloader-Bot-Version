# توکن ربات تلگرام خود را از BotFather گرفته و اینجا وارد کنید:
BOT_TOKEN=your_bot_token_here

# (اختیاری) آدرس سرور محلی تلگرام (Local Bot API) برای ارسال فایل تا ۲ گیگابایت (پیش‌فرض: http://localhost:8081):
# در صورت اجرای داکر telegram-bot-api، ربات خودکار به آن متصل شده و سقف آپلود ۲ گیگ می‌شود.
# LOCAL_BOT_API_URL=http://localhost:8081

# (اختیاری) استخراج خودکار کوکی از مرورگر سیستم برای محتواهای حساس/NSFW و اکانت‌ها:
# مقادیر معتبر: chrome | firefox | edge | brave | opera | safari
# در صورت عدم تنظیم، ربات از فایل‌های کوکی مانند cookies_twitter.txt یا cookies.txt استفاده می‌کند.
# BROWSER_COOKIES=chrome
